# Application Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telemedicine_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_ACCESS_SECRET=telemedicine_jwt_access_secret_key_at_least_32_bytes_len
JWT_REFRESH_SECRET=telemedicine_jwt_refresh_secret_key_at_least_32_bytes_len
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Field-Level PHI Encryption (AES-256-GCM, 32-byte hex key)
ACTIVE_PHI_KEY_VERSION=v1
PHI_ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
